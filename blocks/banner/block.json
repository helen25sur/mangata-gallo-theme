{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mangata-gallo/banner",
  "title": "Mangata Gallo Banner",
  "category": "design",
  "icon": "cover-image",
  "description": "Промо-банер з чотирма зображеннями та закликом до дії.",
  "keywords": ["banner", "hero", "cover"],
  "textdomain": "mangata-gallo-jewelry-theme",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Magnata Gallo"
    },
    "percent": {
      "type": "string",
      "default": "20%"
    },
    "promoText": {
      "type": "string",
      "default": "Diamond Jewelers Value"
    },
    "buttonText": {
      "type": "string",
      "default": "Shop now"
    },
    "buttonLink": {
      "type": "string",
      "default": "#"
    },
    "images": {
      "type": "array",
      "default": [
        { "url": "", "alt": "" },
        { "url": "", "alt": "" },
        { "url": "", "alt": "" },
        { "url": "", "alt": "" }
      ]
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "color": {
      "text": true,
      "background": false
    },
    "spacing": {
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
